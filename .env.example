# App and authentication
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret

# Local PostgreSQL (matches compose.yaml)
POSTGRES_DB=dsh_music
POSTGRES_USER=dsh_music
POSTGRES_PASSWORD=dsh_music_local_password
DATABASE_URL=postgresql://dsh_music:dsh_music_local_password@localhost:5432/dsh_music?schema=public

# Google OAuth / YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts provider refresh tokens at rest. Use a base64-encoded 32-byte value.
TOKEN_ENCRYPTION_KEY=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Product defaults
DEMO_ENABLED=true
NEXT_PUBLIC_DEMO_ENABLED=true
NEXT_PUBLIC_DEFAULT_LOCALE=en
